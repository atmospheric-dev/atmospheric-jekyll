---
layout: null
---
[
{% assign first = true %}
{% for a in site.albums %}
{% unless first %},{% endunless %}{% assign first = false %}
{
  "type": "release",
  "rubric": "Обзоры релизов",
  "title": {{ a.title | jsonify }},
  "subtitle": {{ a.artist | jsonify }},
  "artist": {{ a.artist | jsonify }},
  "cover": {{ a.cover | default: "" | jsonify }},
  "slug": {{ a.name | replace: ".md", "" | jsonify }},
  "url": {{ a.url | relative_url | jsonify }},
  "year": {{ a.year | jsonify }},
  "date": {{ a.date | date: "%Y-%m-%d" | jsonify }},
  "tags": {{ a.genres | jsonify }},
  "label": {{ a.label | default: "" | jsonify }},
  "text": {{ a.excerpt | strip_html | strip_newlines | truncate: 200 | jsonify }}
}
{% endfor %}
{% for p in site.interviews %}
,{
  "type": "interview",
  "rubric": "Интервью",
  "title": {{ p.title | jsonify }},
  "subtitle": {{ p.guests | default: "" | jsonify }},
  "url": {{ p.url | relative_url | jsonify }},
  "year": {{ p.date | date: "%Y" | jsonify }},
  {% if p.published %}"date": {{ p.published | date: "%Y-%m-%d" | jsonify }}{% else %}"date": {{ p.date | date: "%Y-%m-%d" | jsonify }}{% endif %},
  "tags": [],
  "label": "",
  "text": {{ p.description | default: "" | strip_html | strip_newlines | truncate: 200 | jsonify }}
}
{% endfor %}
{% for p in site.notes %}
,{
  "type": "note",
  "rubric": "Заметки с концертов",
  "title": {{ p.title | jsonify }},
  "subtitle": {{ p.artist | default: "" | jsonify }},
  "url": {{ p.url | relative_url | jsonify }},
  "year": {{ p.date | date: "%Y" | jsonify }},
  "date": {{ p.date | date: "%Y-%m-%d" | jsonify }},
  "tags": [],
  "label": "",
  "text": {{ p.description | default: "" | strip_html | strip_newlines | truncate: 200 | jsonify }}
}
{% endfor %}
{% for p in site.articles %}
,{
  "type": "article",
  "rubric": "Статьи",
  "title": {{ p.title | jsonify }},
  "subtitle": "",
  "url": {{ p.url | relative_url | jsonify }},
  "year": {{ p.date | date: "%Y" | jsonify }},
  {% if p.published %}"date": {{ p.published | date: "%Y-%m-%d" | jsonify }}{% else %}"date": {{ p.date | date: "%Y-%m-%d" | jsonify }}{% endif %},
  "tags": [],
  "label": "",
  "text": {{ p.description | default: "" | strip_html | strip_newlines | truncate: 200 | jsonify }}
}
{% endfor %}
{% for p in site.retrospectives %}
,{
  "type": "retro",
  "rubric": "Ретроспектива",
  "title": {{ p.title | jsonify }},
  "subtitle": {{ p.artist | default: "" | jsonify }},
  "url": {{ p.url | relative_url | jsonify }},
  "year": {{ p.date | date: "%Y" | jsonify }},
  "date": {{ p.date | date: "%Y-%m-%d" | jsonify }},
  "tags": [],
  "label": "",
  "text": {{ p.description | default: "" | strip_html | strip_newlines | truncate: 200 | jsonify }}
}
{% endfor %}
{% for p in site.places %}
,{
  "type": "place",
  "rubric": "Атмосферные места",
  "title": {{ p.title | jsonify }},
  "subtitle": {{ p.region | default: "" | jsonify }},
  "url": {{ p.url | relative_url | jsonify }},
  "year": {{ p.date | date: "%Y" | jsonify }},
  "date": {{ p.date | date: "%Y-%m-%d" | jsonify }},
  "tags": [],
  "label": "",
  "text": {{ p.description | default: "" | strip_html | strip_newlines | truncate: 200 | jsonify }}
}
{% endfor %}
]
